# =========================
# Normalización general
# =========================
* text=auto

# =========================
# Código fuente (LF)
# =========================
*.java     text eol=lf
*.xml      text eol=lf
*.properties text eol=lf
*.yml      text eol=lf
*.gradle   text eol=lf
*.md       text eol=lf

# =========================
# Scripts
# =========================
# Windows (CRLF)
*.cmd      text eol=crlf
*.bat      text eol=crlf

# Linux/macOS (LF)
*.sh       text eol=lf

# =========================
# Archivos binarios (sin conversión)
# =========================
*.jar      binary
*.war      binary
*.ear      binary
*.class    binary
*.png      binary
*.jpg      binary
*.gif      binary
*.ico      binary
*.pdf      binary
*.zip      binary
*.tar.gz   binary
*.rar      binary
*.db       binary
*.sqlite   binary
*.jks      binary
*.keystore binary

